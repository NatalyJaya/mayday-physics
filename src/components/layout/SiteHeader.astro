---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../site';
import { stripBase, withBase } from '../../lib/url';

const path = stripBase(Astro.url.pathname);
const links = [
	{ href: withBase('/#temario'), label: 'Temario', active: path === '/' },
	{ href: withBase('/cinematica/movimiento-parabolico/'), label: 'Movimiento parabólico', active: path.startsWith('/cinematica/movimiento-parabolico') },
	{ href: withBase('/fuentes/'), label: 'Fuentes', active: path.startsWith('/fuentes') },
];
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={withBase('/')} aria-label={`${SITE.name}, inicio`}>
			<Logo />
			<span>{SITE.name}</span>
		</a>
		<nav aria-label="Principal">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} aria-current={l.active ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<button class="theme-toggle btn btn-ghost btn-sm" type="button" aria-label="Cambiar entre tema claro y oscuro">
			<span class="sun"><Icon name="sun" /></span>
			<span class="moon"><Icon name="moon" /></span>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 60px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-display);
		font-weight: 650;
		font-size: 1.08rem;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
		margin-right: auto;
		white-space: nowrap;
	}
	nav ul {
		display: flex;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		display: block;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		color: var(--ink-2);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	nav a:hover {
		color: var(--ink);
		background: var(--surface-2);
	}
	nav a[aria-current='page'] {
		color: var(--ink);
		background: var(--surface-3);
	}
	.theme-toggle {
		min-height: 40px;
		width: 40px;
		padding: 0;
	}
	.theme-toggle .moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .moon {
		display: inline-flex;
	}
	@media (max-width: 760px) {
		nav li:nth-child(2) {
			display: none;
		}
		.brand span {
			font-size: 1rem;
		}
	}
	@media (max-width: 420px) {
		nav a {
			padding: 0.4rem 0.5rem;
		}
	}
</style>

<script>
	const KEY = 'mayday-theme';
	const root = document.documentElement;
	const effective = () =>
		root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
	const sync = () => (root.dataset.theme = effective());
	sync();
	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) =>
		btn.addEventListener('click', () => {
			const next = effective() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem(KEY, next);
			} catch {
				/* sin almacenamiento: el cambio dura hasta recargar */
			}
			window.dispatchEvent(new CustomEvent('themechange'));
		}),
	);
</script>
