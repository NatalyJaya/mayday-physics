---
import BlockGlyph from './BlockGlyph.astro';
import Icon from '../ui/Icon.astro';
import { blockUrl, isAvailable, topicUrl, type Block, type Topic } from '../../lib/content';

interface Props {
	block: Block;
	topics: Topic[];
	size?: 'lg' | 'sm';
}
const { block, topics, size = 'lg' } = Astro.props;
const available = topics.filter(isAvailable);
const open = available.length > 0;
---

<article class:list={['block-card', size, { open }]} aria-labelledby={`b-${block.id}`}>
	<header>
		<BlockGlyph icon={block.data.icono} size={size === 'lg' ? 56 : 44} />
		<div class="head">
			<h3 id={`b-${block.id}`}>
				{open ? <a href={blockUrl(block.id)}>{block.data.titulo}</a> : block.data.titulo}
			</h3>
			<p class="lema">{block.data.lema}</p>
		</div>
		{
			open ? (
				<span class="tag tag-ok">
					{available.length} de {topics.length} {topics.length === 1 ? 'tema' : 'temas'}
				</span>
			) : (
				<span class="tag tag-locked">
					<Icon name="lock" size={13} /> Próximamente
				</span>
			)
		}
	</header>
	<p class="desc">{block.data.descripcion}</p>
	<ul class="topics" aria-label={`Temas de ${block.data.titulo}`}>
		{
			topics.map((t) =>
				isAvailable(t) ? (
					<li class="on">
						<a href={topicUrl(t)}>
							<span class="dot" aria-hidden="true" />
							<span class="name">{t.data.titulo}</span>
							<Icon name="arrow-right" size={16} />
						</a>
					</li>
				) : (
					<li class="off">
						<Icon name="lock" size={14} />
						<span class="name">{t.data.sigla ? `${t.data.sigla}: ` : ''}{t.data.titulo}</span>
						<span class="visually-hidden">(próximamente)</span>
					</li>
				),
			)
		}
	</ul>
	{
		open && size === 'lg' && (
			<a class="btn btn-primary cta" href={blockUrl(block.id)}>
				Entrar en {block.data.titulo} <Icon name="arrow-right" />
			</a>
		)
	}
</article>

<style>
	.block-card {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.35rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		height: 100%;
	}
	.block-card.open {
		box-shadow: var(--shadow);
		border-color: var(--line-strong);
	}
	header {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.9rem;
		align-items: center;
	}
	h3 {
		margin: 0;
		font-size: 1.3rem;
	}
	.sm h3 {
		font-size: 1.1rem;
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover {
		text-decoration: underline;
	}
	.lema {
		margin: 0.1rem 0 0;
		color: var(--ink-3);
		font-size: 0.92rem;
	}
	header .tag {
		align-self: start;
	}
	.desc {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.97rem;
	}
	.sm .desc {
		font-size: 0.92rem;
	}
	.topics {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
		border-top: 1px solid var(--line);
		padding-top: 0.6rem;
	}
	.topics li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.93rem;
		min-height: 34px;
	}
	.topics .off {
		color: var(--ink-3);
		padding-inline: 0.5rem;
	}
	.topics .on a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		width: 100%;
		padding: 0.35rem 0.5rem;
		border-radius: 8px;
		background: var(--accent-soft);
		color: var(--ink);
		font-weight: 650;
		text-decoration: none;
	}
	.topics .on a:hover {
		background: color-mix(in srgb, var(--accent-soft) 70%, var(--accent) 12%);
	}
	.topics .on .icon {
		margin-left: auto;
		color: var(--accent);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--ok);
		flex: none;
		margin-inline: 3px;
	}
	.cta {
		align-self: flex-start;
		margin-top: auto;
	}
	@media (max-width: 480px) {
		header {
			grid-template-columns: auto 1fr;
		}
		header .tag {
			grid-column: 1 / -1;
			justify-self: start;
		}
	}
</style>
