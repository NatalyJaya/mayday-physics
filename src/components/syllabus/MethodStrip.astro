---
// Las seis etapas de la metodología. Si se pasa `topic`, cada etapa enlaza
// a la lección correspondiente y muestra su duración.
import { STAGES } from '../../lib/taxonomy';
import { stageUrl, type Lesson, type Topic } from '../../lib/content';

interface Props {
	topic?: Topic;
	lessons?: Lesson[];
	exerciseCount?: number;
}
const { topic, lessons = [], exerciseCount } = Astro.props;
const minutes = (id: string) => lessons.find((l) => l.data.etapa === id)?.data.minutos;
---

<ol class:list={['method', { linked: !!topic }]}>
	{
		STAGES.map((s, i) => {
			const href = topic ? stageUrl(topic, s.id) : undefined;
			const m = minutes(s.id);
			const meta = s.id === 'practica' && exerciseCount ? `${exerciseCount} ejercicios` : m ? `${m} min` : undefined;
			const Tag = href ? 'a' : 'div';
			return (
				<li data-stage={s.id}>
					<Tag class="step" href={href}>
						<span class="n" aria-hidden="true">{i + 1}</span>
						<span class="q">{s.pregunta}</span>
						<strong class="t">{s.titulo}</strong>
						<span class="d">{s.descripcion}</span>
						{meta && <span class="meta">{meta}</span>}
						{topic && (
							<span class="seen" hidden>
								Visto
							</span>
						)}
					</Tag>
				</li>
			);
		})
	}
</ol>

<style>
	.method {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 10px;
		counter-reset: step;
	}
	.step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		height: 100%;
		padding: 1rem 1rem 1.1rem;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line);
		color: inherit;
		text-decoration: none;
	}
	a.step {
		transition:
			border-color 0.15s,
			transform 0.15s,
			box-shadow 0.15s;
	}
	a.step:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow);
		color: inherit;
	}
	.n {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--ink);
		color: var(--bg);
		font: 650 0.95rem var(--font-display);
		margin-bottom: 0.35rem;
	}
	.q {
		font-size: 0.82rem;
		color: var(--ink-3);
		font-weight: 600;
	}
	.t {
		font-family: var(--font-display);
		font-size: 1.02rem;
		line-height: 1.2;
		font-weight: 620;
	}
	.d {
		font-size: 0.88rem;
		color: var(--ink-2);
		line-height: 1.45;
	}
	.meta {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: 0.8rem;
		color: var(--ink-3);
		font-weight: 600;
	}
	.seen {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--ok);
	}
	.seen:not([hidden]) ~ * {
		opacity: 1;
	}
	@media (max-width: 1060px) {
		.method {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.method {
			grid-template-columns: 1fr;
			gap: 8px;
		}
		.step {
			display: grid;
			grid-template-columns: 30px 1fr;
			column-gap: 0.85rem;
			row-gap: 0.15rem;
			padding: 0.85rem 1rem;
		}
		.n {
			grid-row: span 3;
			margin: 0;
		}
		.d {
			display: none;
		}
		.meta {
			padding: 0;
			margin: 0;
			grid-column: 2;
		}
	}
</style>

<script>
	// Marca como «Visto» las etapas que el alumno ya ha abierto (solo en su navegador).
	import { visitedStages } from '../../lib/progress';
	for (const list of document.querySelectorAll<HTMLElement>('.method.linked')) {
		const href = list.querySelector<HTMLAnchorElement>('a.step')?.getAttribute('href') ?? '';
		const topicPath = href.replace(/[^/]+\/$/, '');
		const seen = visitedStages(topicPath);
		list.querySelectorAll<HTMLElement>('li[data-stage]').forEach((li) => {
			if (seen.includes(li.dataset.stage!)) li.querySelector<HTMLElement>('.seen')?.removeAttribute('hidden');
		});
	}
</script>
