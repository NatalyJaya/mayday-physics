---
// Página de una colección (p. ej., una hoja de clase): sus problemas
// principales en orden y, debajo de cada uno, sus variantes.
import { getEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/layout/Breadcrumbs.astro';
import ExerciseMeta from '../../../../components/exercises/ExerciseMeta.astro';
import Icon from '../../../../components/ui/Icon.astro';
import {
	blockUrl,
	exerciseUrl,
	getCollections,
	getExercise,
	getTopic,
	getVariants,
	isAvailable,
	stageUrl,
	topicUrl,
} from '../../../../lib/content';

export async function getStaticPaths() {
	const cols = await getCollections();
	const out = [];
	for (const col of cols) {
		const topic = await getTopic(col.data.tema);
		if (!isAvailable(topic)) continue;
		out.push({ params: { bloque: topic.data.bloque.id, tema: topic.id, coleccion: col.id }, props: { col, topic } });
	}
	return out;
}

const { col, topic } = Astro.props;
const block = await getEntry('bloques', topic.data.bloque.id);
const source = col.data.fuente ? await getEntry('fuentes', col.data.fuente) : undefined;
const groups = await Promise.all(
	col.data.principales.map(async (slug) => ({
		main: await getExercise(topic.id, slug),
		variants: await getVariants(topic.id, slug),
	})),
);
const total = groups.reduce((n, g) => n + 1 + g.variants.length, 0);
const fecha = new Date(col.data.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const LEVEL = ['Más fácil', 'Un paso más', 'Reto'];
---

<BaseLayout title={col.data.titulo} description={col.data.descripcion}>
	<div class="container head">
		<Breadcrumbs
			items={[
				{ label: block?.data.titulo ?? '', href: blockUrl(topic.data.bloque.id) },
				{ label: topic.data.titulo, href: topicUrl(topic) },
				{ label: '6. Práctica', href: stageUrl(topic, 'practica') },
				{ label: col.data.corto },
			]}
		/>
		<p class="eyebrow"><Icon name="layers" size={14} /> Colección de clase · {fecha}</p>
		<h1>{col.data.titulo}</h1>
		<p class="lead">{col.data.descripcion}</p>
		<p class="muted count">
			{groups.length} problemas y {total - groups.length} variantes. Empieza por el problema; cuando lo entiendas, haz sus variantes en orden.
		</p>
	</div>

	<div class="container">
		<ol class="groups">
			{
				groups.map((g, i) => (
					<li class="group">
						<a class="main card" href={exerciseUrl(topic, g.main)} data-solved-id={g.main.id}>
							<span class="n">P{i + 1}</span>
							<span class="body">
								<span class="solved-mark">
									<Icon name="check" size={14} /> Resuelto
								</span>
								<strong class="t">{g.main.data.titulo}</strong>
								<span class="r">{g.main.data.resumen}</span>
								<ExerciseMeta ex={g.main.data} compact />
								{g.main.data.visual.length > 0 && (
									<span class="hasvis">
										<Icon name="eye" size={14} /> Con explicación en dibujos
									</span>
								)}
							</span>
							<Icon name="arrow-right" />
						</a>
						{g.variants.length > 0 && (
							<ol class="vars" aria-label={`Variantes de ${g.main.data.titulo}`}>
								{g.variants.map((v, j) => (
									<li>
										<a class="card" href={exerciseUrl(topic, v)} data-solved-id={v.id}>
											<span class="lvl">
												V{j + 1} · {LEVEL[j] ?? 'Variante'}
												<span class="solved-mark">
													<Icon name="check" size={13} />
												</span>
											</span>
											<strong>{v.data.titulo}</strong>
											<span class="r">{v.data.resumen}</span>
										</a>
									</li>
								))}
							</ol>
						)}
					</li>
				))
			}
		</ol>
		{source && <p class="src muted"><Icon name="quote" size={14} /> {source.data.autor}.</p>}
		<p class="back">
			<a href={stageUrl(topic, 'practica')}><Icon name="arrow-left" size={16} /> Todos los ejercicios del tema</a>
		</p>
	</div>
</BaseLayout>

<script>
	import '../../../../scripts/exercise';
</script>

<style>
	.head {
		padding-top: 1.75rem;
	}
	.count {
		margin-top: 0.75rem;
	}
	.groups {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.75rem;
	}
	.main {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius-lg);
		color: var(--ink);
		text-decoration: none;
		box-shadow: var(--shadow);
		position: relative;
	}
	.main:hover {
		border-color: var(--accent);
		color: var(--ink);
	}
	.n {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: var(--ink);
		color: var(--bg);
		font: 650 1.2rem var(--font-display);
	}
	.body {
		display: grid;
		gap: 0.35rem;
	}
	.t {
		font-family: var(--font-display);
		font-size: 1.2rem;
	}
	.r {
		color: var(--ink-2);
		font-size: 0.94rem;
	}
	.hasvis {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
	}
	.vars {
		list-style: none;
		margin: 0.6rem 0 0 2.2rem;
		padding: 0 0 0 1.2rem;
		border-left: 2px solid var(--line-strong);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.vars a {
		display: grid;
		gap: 0.25rem;
		height: 100%;
		padding: 0.8rem 0.95rem;
		color: var(--ink);
		text-decoration: none;
		font-size: 0.93rem;
	}
	.vars a:hover {
		border-color: var(--accent);
		color: var(--ink);
	}
	.lvl {
		display: flex;
		justify-content: space-between;
		font: 650 0.72rem var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--accent);
	}
	.solved-mark {
		display: none;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--ok);
	}
	:global(.is-solved) .solved-mark {
		display: inline-flex;
	}
	:global(.is-solved) {
		border-color: color-mix(in srgb, var(--ok) 40%, var(--line));
	}
	.src {
		display: flex;
		gap: 0.4rem;
		align-items: baseline;
		margin-top: 2rem;
		font-size: 0.88rem;
	}
	.back a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	@media (max-width: 820px) {
		.vars {
			grid-template-columns: 1fr;
			margin-left: 1rem;
		}
		.main {
			grid-template-columns: auto 1fr;
		}
		.main > :global(.icon) {
			display: none;
		}
	}
</style>
