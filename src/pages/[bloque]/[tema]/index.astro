---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import MethodStrip from '../../../components/syllabus/MethodStrip.astro';
import DecompositionDiagram from '../../../components/sims/DecompositionDiagram.astro';
import Icon from '../../../components/ui/Icon.astro';
import { blockUrl, collectionUrl, getCollections, getExercises, getLessons, getTopics, isAvailable, stageUrl } from '../../../lib/content';
import { DIFFICULTIES, DIFFICULTY_IDS } from '../../../lib/taxonomy';
import { tex } from '../../../lib/rich-text';

export async function getStaticPaths() {
	return (await getTopics())
		.filter(isAvailable)
		.map((topic) => ({ params: { bloque: topic.data.bloque.id, tema: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const block = await getEntry('bloques', topic.data.bloque.id);
const lessons = await getLessons(topic.id);
const practice = await getExercises(topic.id, 'practica');
const allTopics = await getTopics();
const cols = await Promise.all(
	(await getCollections(topic.id)).map(async (c) => ({
		...c,
		n: (await getExercises(topic.id, 'practica')).filter((e) => e.data.coleccion === c.id).length,
		fecha: new Date(c.data.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' }),
	})),
);
const reqs = topic.data.requisitos.map((r) => allTopics.find((t) => t.id === r.id)!).filter(Boolean);
const byDifficulty = DIFFICULTY_IDS.map((d) => ({
	id: d,
	...DIFFICULTIES[d],
	n: practice.filter((e) => e.data.dificultad === d).length,
}));

// Mapa rápido: cada pregunta típica se traduce en una condición física.
const map = [
	{ q: '¿Cuándo llega al suelo?', c: await tex('\\cy{y} = 0'), d: 'el tiempo de vuelo (descarta t = 0 o la raíz negativa)' },
	{ q: '¿Dónde cae? (alcance)', c: await tex('\\cx{x}(t_{\\text{vuelo}})'), d: 'sustituye el tiempo de vuelo en el eje X' },
	{ q: '¿Qué altura máxima alcanza?', c: await tex('\\cy{v_y} = 0'), d: 'el tiempo de subida; luego sustitúyelo en y' },
	{ q: '¿Con qué velocidad llega?', c: await tex('v = \\sqrt{\\cx{v_x}^2 + \\cy{v_y}^2}'), d: 'cada componente en el instante del impacto' },
	{ q: '¿Supera un obstáculo a distancia d?', c: await tex('\\cx{x} = d'), d: 'el instante en que llega allí; luego su altura y' },
	{ q: '¿Está subiendo o bajando?', c: await tex('\\text{signo de } \\cy{v_y}'), d: 'positivo: sube · negativo: baja' },
];
---

<BaseLayout title={topic.data.titulo} description={topic.data.resumen}>
	<section class="container head">
		<Breadcrumbs items={[{ label: block?.data.titulo ?? '', href: blockUrl(topic.data.bloque.id) }, { label: topic.data.titulo }]} />
		<div class="hero">
			<div>
				<p class="eyebrow">{block?.data.titulo} · Tema {topic.data.orden}</p>
				<h1>{topic.data.titulo}</h1>
				<p class="lead">{topic.data.esencia ?? topic.data.resumen}</p>
				<div class="actions">
					<a class="btn btn-primary" href={stageUrl(topic, 'fenomeno')}>Empezar por el fenómeno <Icon name="arrow-right" /></a>
					<a class="btn" href={`${stageUrl(topic, 'visualiza')}#laboratorio`}><Icon name="flask" /> Ir al laboratorio</a>
					<a class="btn btn-ghost" href={stageUrl(topic, 'practica')}><Icon name="pencil" /> Practicar</a>
				</div>
			</div>
			<div class="card figure">
				<DecompositionDiagram animate />
			</div>
		</div>
	</section>

	<section class="container section-tight">
		<h2>Tu recorrido</h2>
		<MethodStrip topic={topic} lessons={lessons} exerciseCount={practice.length} />
	</section>

	{
		cols.length > 0 && (
			<section class="container section-tight" id="colecciones">
				<h2>Colecciones de clase</h2>
				<p class="muted cols-intro">Los problemas de tus hojas de clase, resueltos y con variantes para practicar.</p>
				<div class="cols">
					{cols.map((c) => (
						<a class="col-card" href={collectionUrl(topic, c.id)}>
							<Icon name="layers" size={26} />
							<span>
								<span class="col-k">Hoja de clase · {c.fecha}</span>
								<strong>{c.data.titulo}</strong>
								<span class="col-d">{c.data.principales.length} problemas con explicación en dibujos y {c.n - c.data.principales.length} variantes</span>
							</span>
							<Icon name="arrow-right" />
						</a>
					))}
				</div>
			</section>
		)
	}

	<section class="container section-tight two">
		<div class="card box">
			<h2 class="h3">Antes de empezar</h2>
			<p>Este tema junta dos movimientos que ya conoces:</p>
			<ul class="reqs">
				{
					reqs.map((r) => (
						<li>
							<strong>{r.data.sigla ?? r.data.titulo}</strong>: {r.data.resumen}
							{!isAvailable(r) && <span class="tag tag-locked"><Icon name="lock" size={12} /> Tema en preparación</span>}
						</li>
					))
				}
			</ul>
			<p class="muted">
				No hace falta que los domines: en la etapa 2 tienes un <a href={`${stageUrl(topic, 'variables')}#repaso-exprés-mru-y-mrua`}>repaso exprés</a> con lo imprescindible.
			</p>
			<h3 class="h4">Qué ejercicios encontrarás</h3>
			<ul class="levels">
				{
					byDifficulty.map((d) => (
						<li>
							<span class="lv" data-level={d.nivel}>{'●'.repeat(d.nivel)}<span class="off">{'●'.repeat(4 - d.nivel)}</span></span>
							<span><strong>{d.label}</strong>: {d.n} {d.n === 1 ? 'ejercicio' : 'ejercicios'}</span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="card box">
			<h2 class="h3">Mapa rápido: cada pregunta, una condición</h2>
			<p class="muted">El truco de casi todos los problemas: traducir lo que te preguntan a una condición física.</p>
			<table class="map">
				<thead><tr><th>Si te preguntan…</th><th>Condición</th><th>Te da…</th></tr></thead>
				<tbody>
					{
						map.map((m) => (
							<tr>
								<td>{m.q}</td>
								<td class="c" set:html={m.c} />
								<td>{m.d}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
</BaseLayout>

<style>
	.head {
		padding-top: 1.75rem;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 1rem + 3vw, 3rem);
		align-items: center;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}
	.figure {
		padding: 1.1rem 1.25rem 1.25rem;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}
	.section-tight {
		padding-top: 3rem;
	}
	.cols-intro {
		margin-top: -0.25rem;
	}
	.cols {
		display: grid;
		gap: 0.6rem;
	}
	.col-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.3rem;
		border-radius: var(--radius-lg);
		background: var(--ink);
		color: var(--bg);
		text-decoration: none;
	}
	.col-card:hover {
		color: var(--bg);
		box-shadow: var(--shadow);
	}
	.col-card > span {
		display: grid;
		flex: 1;
		gap: 0.15rem;
	}
	.col-k {
		font: 650 0.72rem var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
	}
	.col-card strong {
		font-family: var(--font-display);
		font-size: 1.2rem;
	}
	.col-d {
		font-size: 0.92rem;
		opacity: 0.8;
	}
	.two {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 1rem;
		align-items: start;
	}
	.box {
		padding: 1.35rem 1.4rem;
		border-radius: var(--radius-lg);
	}
	.h3 {
		font-size: 1.25rem;
	}
	.h4 {
		font-size: 1rem;
		margin-top: 1.5rem;
	}
	.reqs,
	.levels {
		padding-left: 1.1em;
		margin: 0 0 1rem;
		display: grid;
		gap: 0.5rem;
	}
	.reqs .tag {
		margin-left: 0.35rem;
	}
	.levels {
		list-style: none;
		padding: 0;
	}
	.levels li {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
	}
	.lv {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: var(--accent);
		width: 4.5em;
		flex: none;
	}
	.lv .off {
		color: var(--line-strong);
	}
	.map {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}
	.map th,
	.map td {
		text-align: left;
		padding: 0.6rem 0.5rem;
		border-bottom: 1px solid var(--line);
		vertical-align: top;
	}
	.map th {
		font: 600 0.8rem var(--font-display);
		color: var(--ink-3);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.map td:first-child {
		font-weight: 700;
	}
	.map .c {
		white-space: nowrap;
	}
	.map td:last-child {
		color: var(--ink-2);
	}
	@media (max-width: 980px) {
		.hero,
		.two {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 560px) {
		.map thead {
			display: none;
		}
		.map tr {
			display: grid;
			grid-template-columns: 1fr auto;
			border-bottom: 1px solid var(--line);
			padding: 0.5rem 0;
		}
		.map td {
			border: 0;
			padding: 0.15rem 0;
		}
		.map td:last-child {
			grid-column: 1 / -1;
		}
	}
</style>
